# Store real values in the deployment secret; never commit them or put them in the web bundle.
CALC_BIND=127.0.0.1:8730
CALC_DATABASE_URL=postgresql:///silicon_calc?host=/var/run/postgresql&user=calc
CALC_APP_ID=calc
CALC_APP_SECRET=REPLACE
CALC_ACCOUNTS_URL=https://accounts.teamofsilicons.com
CALC_WEB_URL=https://calc.teamofsilicons.com
CALC_TING_URL=https://backend.ting.teamofsilicons.com
CALC_BLOB_DIR=/var/lib/silicon-calc/blobs
CALC_RUNNER_PYTHON=/opt/silicon-calc/runner-venv/bin/python
CALC_RUNNER_LIBREOFFICE=/usr/bin/soffice
CALC_CODE_SANDBOX=bwrap
CALC_CODE_TIMEOUT_SECONDS=60
CALC_RUNNER_NUMBERS_ENABLE=0
CALC_LOG=info,sqlx=warn
